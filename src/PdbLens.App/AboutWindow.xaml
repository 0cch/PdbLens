<Window
    x:Class="PdbLens.App.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About PdbLens">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AboutTitleBar"
              AutomationProperties.Name="About PdbLens title bar"
              Height="32"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="4">
                    <Border.Background>
                        <ImageBrush ImageSource="ms-appx:///Assets/Square44x44Logo.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock Text="About PdbLens"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,24,28,20" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="64"
                    Height="64"
                    CornerRadius="12"
                    VerticalAlignment="Top">
                <Border.Background>
                    <ImageBrush ImageSource="ms-appx:///Assets/Square150x150Logo.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="PdbLens"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="26"
                           LineHeight="34"
                           FontWeight="SemiBold"
                           TextAlignment="Left" />
                <Border Padding="7,1"
                        HorizontalAlignment="Left"
                        CornerRadius="9"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="VersionText"
                               Text="Version"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Text="A WinUI 3 PDB symbol explorer powered by Microsoft DIA and SymWrap."
                           Margin="0,6,0,0"
                           TextAlignment="Left"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
                    <HyperlinkButton Content="GitHub repository"
                                     Padding="0"
                                     NavigateUri="https://github.com/0cch/PdbLens" />
                    <HyperlinkButton Content="LGPL-3.0 license"
                                     Padding="0"
                                     NavigateUri="https://github.com/0cch/PdbLens/blob/main/LICENSE" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="28,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="Copyright © 0CCh"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
