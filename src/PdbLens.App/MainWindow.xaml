<Window
    x:Class="PdbLens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PdbLens.Core.Models"
    Title="PDB Lens">

    <Grid x:Name="RootGrid" Background="Transparent"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Padding="8,6,12,6" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CommandBar DefaultLabelPosition="Collapsed" IsOpen="False" ClosedDisplayMode="Compact"
                            Background="Transparent" HorizontalAlignment="Left">
                    <AppBarButton x:Name="OpenPdbButton" Icon="OpenFile" Label="Open PDB"
                                  ToolTipService.ToolTip="Open PDB (Ctrl+O)" Click="OpenPdb_Click" />
                    <AppBarButton x:Name="ClosePdbButton" Icon="Cancel" Label="Close PDB"
                                  ToolTipService.ToolTip="Close selected PDB" Click="ClosePdb_Click" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="BackButton" Icon="Back" Label="Back" IsEnabled="False"
                                  ToolTipService.ToolTip="Back (Alt+Left)" Click="Back_Click" />
                    <AppBarButton x:Name="ForwardButton" Icon="Forward" Label="Forward" IsEnabled="False"
                                  ToolTipService.ToolTip="Forward (Alt+Right)" Click="Forward_Click" />
                </CommandBar>

                <ComboBox x:Name="PdbFilterBox" Grid.Column="1" MinWidth="220" MaxWidth="320"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          DisplayMemberPath="DisplayName" SelectionChanged="PdbFilter_SelectionChanged"
                          ToolTipService.ToolTip="Filter symbols by PDB" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                    <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False"
                            ToolTipService.ToolTip="Copy C/C++ definition">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="12,8,12,0" IsOpen="False"
                 IsClosable="True" Severity="Error" />

        <Grid Grid.Row="2" Padding="12,10,12,10" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="360" MinWidth="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search symbols (Ctrl+F)"
                                    TextChanged="SearchBox_TextChanged">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Symbols" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="SymbolCountText" Text="No symbols loaded" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <DropDownButton Grid.Column="1" Content="Filters" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Filter symbol categories">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel MinWidth="240" Spacing="2">
                                        <TextBlock Text="Symbol categories" Margin="8,4,8,8"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <CheckBox x:Name="StructFilter" Content="Struct" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                        <CheckBox x:Name="ClassFilter" Content="Class" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                        <CheckBox x:Name="UnionFilter" Content="Union" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                        <CheckBox x:Name="EnumFilter" Content="Enum" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                        <CheckBox x:Name="TypedefFilter" Content="Typedef" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                        <CheckBox x:Name="FunctionFilter" Content="Function" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                        <CheckBox x:Name="DataFilter" Content="Data" IsChecked="False" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                        <CheckBox x:Name="PublicSymbolFilter" Content="Public symbol" IsChecked="False" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <ListView x:Name="SymbolsList" Grid.Row="2" SelectionMode="Single"
                              SelectionChanged="SymbolsList_SelectionChanged" IsItemClickEnabled="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SymbolItem">
                                <Grid Padding="2,7" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" FontFamily="Cascadia Mono, Consolas"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button x:Name="LoadMoreButton" Grid.Row="3" Content="Load more symbols"
                            HorizontalAlignment="Stretch" Click="LoadMore_Click" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border x:Name="PaneSplitter" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" PointerEntered="PaneSplitter_PointerEntered" PointerPressed="PaneSplitter_PointerPressed" PointerMoved="PaneSplitter_PointerMoved" PointerReleased="PaneSplitter_PointerReleased" PointerCaptureLost="PaneSplitter_PointerCaptureLost" />

            <Border Grid.Column="2" Margin="8,0,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="18,14,14,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="BreadcrumbText" Text="No symbol selected" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SymbolTitle" Text="Open a PDB to begin"
                                       Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SymbolMetadata" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="14">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8">
                            <Grid x:Name="CodeSurface" Visibility="Collapsed">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Enabled"
                                              VerticalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Enabled"
                                              ZoomMode="Disabled">
                                    <Grid Padding="0,12,20,36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CodeLineNumbers" Padding="0,0,14,0" TextAlignment="Right"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="13" LineHeight="20"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   IsHitTestVisible="False" />
                                        <RichTextBlock x:Name="CodeRichText" Grid.Column="1"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="13" LineHeight="20"
                                                       LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"
                                                       IsTextSelectionEnabled="True" />
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="10" MaxWidth="480">
                            <FontIcon Glyph="&#xE8F1;" FontSize="42"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Explore PDB symbols" HorizontalAlignment="Center"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Open a PDB, select a structure, and follow linked child types."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Open PDB" HorizontalAlignment="Center" Click="OpenPdb_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="12,5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="MemoryText" Grid.Column="1" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
