<Window
    x:Class="PdbLens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PdbLens.Core.Models"
    Title="PDB Lens">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="OpenPdbButton" Content="Open PDB" Click="OpenPdb_Click" />
                <Button x:Name="ClosePdbButton" Grid.Column="1" Content="Close PDB" Click="ClosePdb_Click" />
                <TextBlock Grid.Column="2" Text="PDB" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="PdbFilterBox" Grid.Column="3" MinWidth="260"
                          DisplayMemberPath="DisplayName" SelectionChanged="PdbFilter_SelectionChanged" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                    <Button x:Name="BackButton" Content="Back" Click="Back_Click" IsEnabled="False" />
                    <Button x:Name="ForwardButton" Content="Forward" Click="Forward_Click" IsEnabled="False" />
                    <Button x:Name="CopyButton" Content="Copy code" Click="Copy_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="12,6,12,0" IsOpen="False"
                 IsClosable="True" Severity="Error" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" MinWidth="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Padding="12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="Symbols" FontSize="20" FontWeight="SemiBold" />
                    <TextBox x:Name="SearchBox" PlaceholderText="Search symbols..." TextChanged="SearchBox_TextChanged" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="StructFilter" Content="Struct" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                    <CheckBox x:Name="ClassFilter" Grid.Column="1" Content="Class" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                    <CheckBox x:Name="UnionFilter" Grid.Column="2" Content="Union" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                    <CheckBox x:Name="EnumFilter" Grid.Row="1" Content="Enum" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                    <CheckBox x:Name="TypedefFilter" Grid.Row="1" Grid.Column="1" Content="Typedef" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                    <CheckBox x:Name="FunctionFilter" Grid.Row="1" Grid.Column="2" Content="Function" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                    <CheckBox x:Name="DataFilter" Grid.Row="2" Content="Data" IsChecked="False" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                    <CheckBox x:Name="PublicSymbolFilter" Grid.Row="2" Grid.Column="1" Content="Public" IsChecked="False" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                </Grid>

                <ListView x:Name="SymbolsList" Grid.Row="2" SelectionMode="Single"
                          SelectionChanged="SymbolsList_SelectionChanged" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SymbolItem">
                            <Grid Padding="2,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind DisplayKind}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="LoadMoreButton" Grid.Row="3" Content="Load more" HorizontalAlignment="Stretch"
                        Click="LoadMore_Click" Visibility="Collapsed" />
            </Grid>

            <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="16,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="BreadcrumbText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No symbol selected" />
                            <TextBlock x:Name="SymbolTitle" FontSize="24" FontWeight="SemiBold" Text="Open a PDB to begin" />
                            <TextBlock x:Name="SymbolMetadata" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <WebView2 x:Name="CodeWebView" Visibility="Collapsed" />
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="Select a symbol from the left list" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="PDB Lens renders the first level in C/C++ syntax and links known child types."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Padding="12,5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="MemoryText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
