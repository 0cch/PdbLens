<Window
    x:Class="PdbLens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PdbLens.Core.Models"
    Title="PdbLens">


    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop">
    <Grid.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TitleBar x:Name="AppTitleBar"
                      Title="PdbLens"
                      Height="48"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
                </TitleBar.IconSource>
                <TitleBar.Content>
                    <Grid Padding="0,0,12,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="BackButton" AutomationProperties.Name="Back" Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTipService.ToolTip="Back (Alt+Left)" Click="Back_Click"
                                    IsEnabled="False">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <Button x:Name="ForwardButton" AutomationProperties.Name="Forward" Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTipService.ToolTip="Forward (Alt+Right)" Click="Forward_Click"
                                    IsEnabled="False">
                                <FontIcon Glyph="&#xE72A;" FontSize="14" />
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="TitleSubtitleText"
                                   Grid.Column="1"
                                   Text="PDB symbol explorer"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                            <Button x:Name="OpenPdbButton"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Open PDB (Ctrl+O)"
                                    Click="OpenPdb_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Open PDB" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TitleBar.Content>
            </TitleBar>

            <Grid x:Name="FallbackToolbar"
                  Visibility="Collapsed"
                  Padding="12,6"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="FallbackBackButton" AutomationProperties.Name="Back" Style="{StaticResource TitleBarButtonStyle}"
                            ToolTipService.ToolTip="Back (Alt+Left)" Click="Back_Click"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="FallbackForwardButton" AutomationProperties.Name="Forward" Style="{StaticResource TitleBarButtonStyle}"
                            ToolTipService.ToolTip="Forward (Alt+Right)" Click="Forward_Click"
                            IsEnabled="False">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="PdbLens" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                <Button x:Name="FallbackOpenPdbButton" Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Open PDB (Ctrl+O)"
                        Click="OpenPdb_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open PDB" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <InfoBar x:Name="MessageBar"
                 Grid.Row="1"
                 Margin="16,8,16,0"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="320" MinWidth="280" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="16,18,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Symbols" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="SymbolCountText" Text="No symbols loaded"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <DropDownButton Grid.Column="1" Content="Filters" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Filter symbol categories">
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel MinWidth="240" Spacing="2">
                                    <TextBlock Text="Symbol categories" Margin="8,4,8,8"
                                               FontWeight="SemiBold" />
                                    <CheckBox x:Name="StructFilter" Content="Struct" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    <CheckBox x:Name="ClassFilter" Content="Class" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    <CheckBox x:Name="UnionFilter" Content="Union" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    <CheckBox x:Name="EnumFilter" Content="Enum" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    <CheckBox x:Name="TypedefFilter" Content="Typedef" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    <CheckBox x:Name="FunctionFilter" Content="Function" IsChecked="True" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    <CheckBox x:Name="DataFilter" Content="Data" IsChecked="False" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                    <CheckBox x:Name="PublicSymbolFilter" Content="Public symbol" IsChecked="False" Checked="CategoryFilter_Changed" Unchecked="CategoryFilter_Changed" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <Grid Grid.Row="1" Margin="16,0,16,10" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PdbFilterBox"
                              HorizontalAlignment="Stretch"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="PdbFilter_SelectionChanged"
                              ToolTipService.ToolTip="Filter symbols by PDB" />
                    <Button x:Name="ClosePdbButton" Grid.Column="1"
                            AutomationProperties.Name="Close PDB"
                            Style="{StaticResource TitleBarButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Close selected PDB"
                            Click="ClosePdb_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                    </Button>
                </Grid>

                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Row="2"
                                Margin="16,0,16,10"
                                PlaceholderText="Search symbols (Ctrl+F)"
                                TextChanged="SearchBox_TextChanged">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>

                <ListView x:Name="SymbolsList"
                          Grid.Row="3"
                          Margin="8,0,8,0"
                          SelectionMode="Single"
                          SelectionChanged="SymbolsList_SelectionChanged"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SymbolItem">
                            <Grid Padding="4,7" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30"
                                        CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}"
                                              FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="LoadMoreButton"
                        Grid.Row="4"
                        Margin="16,8,16,14"
                        HorizontalAlignment="Stretch"
                        Content="Load more"
                        Visibility="Collapsed"
                        Click="LoadMore_Click" />
            </Grid>

            <Border x:Name="PaneSplitter"
                    Grid.Column="1"
                    AutomationProperties.Name="Resize symbol pane"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                    PointerEntered="PaneSplitter_PointerEntered"
                    PointerPressed="PaneSplitter_PointerPressed"
                    PointerMoved="PaneSplitter_PointerMoved"
                    PointerReleased="PaneSplitter_PointerReleased"
                    PointerCaptureLost="PaneSplitter_PointerCaptureLost" />

            <Grid Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="20,14,20,12"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="BreadcrumbText"
                                       Text="No symbol selected"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SymbolTitle"
                                       Text="Open a PDB to begin"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SymbolMetadata"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="CopyButton"
                                Grid.Column="1"
                                Click="Copy_Click"
                                IsEnabled="False"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Copy C/C++ definition">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,14,20,18">
                    <Border x:Name="CodeSurface"
                            Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Enabled"
                                      ZoomMode="Disabled">
                            <Grid Padding="0,14,24,36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CodeLineNumbers"
                                           Padding="0,0,14,0"
                                           TextAlignment="Right"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13"
                                           LineHeight="20"
                                           LineStackingStrategy="BlockLineHeight"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           IsHitTestVisible="False" />
                                <RichTextBlock x:Name="CodeRichText"
                                               Grid.Column="1"
                                               AutomationProperties.Name="Symbol definition"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="13"
                                               LineHeight="20"
                                               LineStackingStrategy="BlockLineHeight"
                                               TextWrapping="NoWrap"
                                               IsTextSelectionEnabled="True" />
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                MaxWidth="360">
                        <Border Width="52" Height="52"
                                CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE8F1;"
                                      FontSize="26"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Open a PDB to inspect symbols"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   LineHeight="24"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Search structures and functions, then follow linked child types in the definition view."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Open PDB"
                                HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OpenPdb_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Padding="16,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MemoryText"
                           Grid.Column="1"
                           Style="{StaticResource CaptionTextStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
